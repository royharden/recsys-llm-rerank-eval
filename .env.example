# Browser console (Vite). Public values only: the anon key is designed to be public and RLS protects every row.
# Never put a secret in a VITE_ variable; everything VITE_* is shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CLI live path only (`npm run eval -- login`, `--run-id`). Leave commented for the mock path.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Server secrets are set in the Bolt Database function settings only, never in this file:
#   ANTHROPIC_API_KEY, TYPESAFE_API_KEY, optional ALLOWED_ORIGIN
# Platform-injected into the function: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
